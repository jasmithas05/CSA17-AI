from collections import deque

def solve(start, goal):
    q = deque([(start, [])])
    visited = {tuple(start)}

    while q:
        state, path = q.popleft()

        if state == goal:
            for s in path + [state]:
                print(s[:3])
                print(s[3:6])
                print(s[6:])
                print()
            return

        i = state.index(0)
        for j in [i-3, i+3, i-1, i+1]:
            if 0 <= j < 9 and not (abs(i-j) == 1 and i//3 != j//3):
                new = state[:]
                new[i], new[j] = new[j], new[i]
                t = tuple(new)

                if t not in visited:
                    visited.add(t)
                    q.append((new, path + [state]))

start = [1, 2, 3, 4, 0, 6, 7, 5, 8]
goal  = [1, 2, 3, 4, 5, 6, 7, 8, 0]

solve(start, goal)
