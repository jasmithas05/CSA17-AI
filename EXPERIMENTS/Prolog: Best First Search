best_first(Start, Goal) :-
    search([[0, Start, [Start]]], Goal).

search([[_, Goal, Path]|_], Goal) :-
    reverse(Path, Result),
    write('Path: '), write(Result), nl.

search([[Cost, Node, Path]|Rest], Goal) :-
    findall([NewCost, Next, [Next|Path]],
        (edge(Node, Next, Weight),
         \+ member(Next, Path),
         NewCost is Cost + Weight),
        Children),
    append(Rest, Children, Queue),
    sort(Queue, SortedQueue),
    search(SortedQueue, Goal).

