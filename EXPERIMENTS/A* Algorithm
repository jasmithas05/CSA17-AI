import heapq

graph = {
    'A': [('B', 1), ('C', 4)],
    'B': [('D', 2), ('E', 5)],
    'C': [('D', 1)],
    'D': [('E', 1)],
    'E': []
}

h = {'A': 5, 'B': 4, 'C': 2, 'D': 1, 'E': 0}

def astar(start, goal):
    q = [(h[start], 0, start, [start])]
    visited = set()

    while q:
        f, g, node, path = heapq.heappop(q)

        if node == goal:
            print("Path:", path)
            print("Cost:", g)
            return

        if node not in visited:
            visited.add(node)

            for nxt, cost in graph[node]:
                if nxt not in visited:
                    new_g = g + cost
                    heapq.heappush(
                        q, (new_g + h[nxt], new_g, nxt, path + [nxt])
                    )

astar('A', 'E')
