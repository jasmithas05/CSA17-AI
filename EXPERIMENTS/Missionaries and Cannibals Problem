from collections import deque

def solve():
    q = deque([((3, 3, 1), [])])
    visited = set()

    while q:
        (m, c, b), path = q.popleft()

        if (m, c, b) == (0, 0, 0):
            print(path + [(m, c, b)])
            return

        if (m, c, b) in visited:
            continue
        visited.add((m, c, b))

        for x, y in [(1,0), (2,0), (0,1), (0,2), (1,1)]:
            nm, nc = (m-x, c-y) if b else (m+x, c+y)

            if 0 <= nm <= 3 and 0 <= nc <= 3:
                if (nm == 0 or nm >= nc) and (3-nm == 0 or 3-nm >= 3-nc):
                    q.append(((nm, nc, 1-b), path + [(m, c, b)]))

solve()
